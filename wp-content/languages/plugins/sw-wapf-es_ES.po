msgstr "No se encontraron grupos de campos en la papelera"

msgid "The field \"%s\" contains a disallowed date."
msgstr "El campo \"%s\" contiene una fecha no permitida."

msgid "The field \"%s\" has an invalid date."
msgstr "El campo \"%s\" tiene una fecha no válida."

msgid "The field \"%s\" is older than the minimum allowed date."
msgstr "El campo \"%s\" es anterior a la fecha mínima permitida."

msgid "The field \"%s\" is later than the maximum allowed date."
msgstr "El campo \"%s\" es posterior a la fecha máxima permitida."

msgid "Today's date can't be selected in the field \"%s\" because it is after %s."
msgstr "No se puede seleccionar la fecha de hoy en el campo \"%s\" porque es posterior a %s."

msgid "The field \"%s\" is required."
msgstr "El campo \"%s\" es obligatorio."

msgid "The field \"%s\" has an incorrect date format."
msgstr "El campo \"%s\" tiene un formato de fecha incorrecto."

msgid "\"%s\" can't be equal to today."
msgstr "\"%s\" no puede ser igual a hoy."

msgid "\"%s\" can't be in the future."
msgstr "\"%s\" no puede ser una fecha futura."

msgid "\"%s\" can't be in the past."
msgstr "\"%s\" no puede ser una fecha pasada."

msgid "The field \"%s\" requires a minimum of %s."
msgstr "El campo \"%s\" requiere un mínimo de %s."

msgid "The field \"%s\" requires a maximum of %s."
msgstr "El campo \"%s\" requiere un máximo de %s."

msgid "\"%s\" requires a minimum of %s choices."
msgstr "\"%s\" requiere un mínimo de %s opciones."

msgid "\"%s\" requires a maximum of %s choices."
msgstr "\"%s\" requiere un máximo de %s opciones."

msgid "The item \"%s\" requires a minimum quantity of %s."
msgstr "El artículo \"%s\" requiere una cantidad mínima de %s."

msgid "The item \"%s\" requires a maximum quantity of %s."
msgstr "El artículo \"%s\" requiere una cantidad máxima de %s."

msgid "The field \"%s\" requires at minimum %s selections."
msgstr "El campo \"%s\" requiere al menos %s selecciones."

msgid "The field \"%s\" requires at maximum %s selections."
msgstr "El campo \"%s\" requiere como máximo %s selecciones."


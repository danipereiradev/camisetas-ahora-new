msgid "Product Field Groups"
msgstr "Grupos de campos de producto"

msgid "Field Group"
msgstr "Grupo de campos"

msgid "Add New"
msgstr "Añadir nuevo"

msgid "Add New Product Field Group"
msgstr "Añadir nuevo grupo de campos de producto"

msgid "Edit Product Field Group"
msgstr "Editar grupo de campos de producto"

msgid "New Field Group"
msgstr "Nuevo grupo de campos"

msgid "View Field Group"
msgstr "Ver grupo de campos"

msgid "Search Field Groups"
msgstr "Buscar grupos de campos"

